  <DataSets>
    <DataSet Name="DataSet">
      <Query>
        <DataSourceName>SQLServerDataSource</DataSourceName>
        <CommandText>SELECT
    [Survey_type],
    [Brand_Name],
    [Customer_Name],
    [Product],
    [Order_Id],
    [Response_ID],
    [Occupation],
    [Month],
    [Gender],
    [Year],
    [Bill_No],
    [Product_Price],
    [Product_Price] * 5 AS [New Product Price],
    [Mobile_No],
    [Location],
    [Rating],
    [Promoter_Score]
FROM dbo.Dataset;

   
</CommandText>
      </Query>
      <Fields>
